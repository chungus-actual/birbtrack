# Your time zone, the same one BirdNET-Go uses
TZ=America/Denver

# Where people will reach the site. Discord posts and link previews point here.
BT_PUBLIC_URL=https://birds.example.com

# How link previews name the place: "12 species heard in a backyard in Boulder so far today"
BT_PLACE=a backyard in Boulder

# A Discord channel webhook, for new yard birds, birds back after a long absence and the weekly report.
# Leave empty for no posts.
BT_DISCORD_WEBHOOK=

# The station's location is read from BirdNET-Go. Set these only to override it.
# BT_LAT=
# BT_LON=

# The range map: americas, europe, africa, asia, oceania, or auto (the one that holds the station)
# BT_REGION=auto
