[Unit]
Description=Backyard mic as RTSP (rtsp://:8554/birdmic)
After=network-online.target sound.target
Wants=network-online.target

[Service]
EnvironmentFile=-/etc/default/birdmic
ExecStart=/usr/bin/python3 /usr/local/bin/birdmic-rtsp.py
# any account in the audio group
User=birb
SupplementaryGroups=audio
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
